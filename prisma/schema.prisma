// Better Auth's own tables (User/Session/Account/Verification below) are
// generated via `npx auth generate` and owned by it — do not hand-edit
// their fields. Domain models added below never get a Prisma `@relation`
// pointing into these models, on purpose: a future `auth generate` run
// overwrites this whole block, and a relation would need a matching field
// added there too. Where a domain row needs to reference a user (e.g.
// Membership.userId), it's a plain column with a real Postgres foreign key
// added by hand in the migration SQL — enforced in the database, invisible
// to Prisma, safe across regenerations.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------
// Phase 1 domain models — docs/01-DATABASE-SPEC.md, scoped to what
// docs/05-MVP-ROADMAP.md Phase 1 actually asks for: organization,
// companies, users, memberships, RBAC, company access. Payments,
// expenses, contracts and freelancers belong to later phases and are
// intentionally not added yet, even though prisma/schema.prisma.example
// sketches them — adding them now would be scope creep ahead of their
// own vertical slice. Bank accounts were added in Phase 3, below.
// ---------------------------------------------------------------------

// docs/07-SECURITY-AND-AUDIT.md "Authorization" — fixed role set, shared
// by org-level and company-level membership.
enum OrgRole {
  OWNER
  ADMIN
  TREASURY_MANAGER
  APPROVER
  ACCOUNTANT
  VIEWER
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Organization {
  id           String   @id @default(uuid())
  name         String
  baseCurrency String   @db.Char(3)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companies    Company[]
  memberships  Membership[]
  auditEvents  AuditEvent[]
  expenseCategories ExpenseCategory[]
  counterparties Counterparty[]
  providers      Provider[]

  @@map("organizations")
}

model Company {
  id                 String        @id @default(uuid())
  organizationId     String
  legalName          String
  countryCode        String        @db.Char(2)
  registrationNumber String?
  taxIdentifier      String?
  baseCurrency       String        @db.Char(3)
  status             CompanyStatus @default(ACTIVE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id])
  companyMemberships CompanyMembership[]
  bankAccounts       BankAccount[]
  intercompanyTransfersOut IntercompanyTransfer[] @relation("IntercompanyFrom")
  intercompanyTransfersIn  IntercompanyTransfer[] @relation("IntercompanyTo")
  expenses           Expense[]
  budgets            Budget[]
  payments           Payment[]

  @@unique([organizationId, legalName])
  @@index([organizationId])
  @@map("companies")
}

// Org-level role. userId is Better Auth's user.id — see the note at the
// top of this file for why it's a plain column, not a Prisma relation.
model Membership {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           OrgRole
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

// Company-level access — org membership alone does not grant access to a
// specific company (docs/05-MVP-ROADMAP.md Phase 1: "company access").
model CompanyMembership {
  id        String   @id @default(uuid())
  companyId String
  userId    String
  role      OrgRole
  createdAt DateTime @default(now())

  company   Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, userId])
  @@index([userId])
  @@map("company_memberships")
}

// Append-only — see docs/01-DATABASE-SPEC.md. No UPDATE/DELETE grant is
// given to the application's runtime role (enforced in migration SQL).
model AuditEvent {
  id             String       @id @default(uuid())
  organizationId String
  actorUserId    String?
  action         String
  objectType     String
  objectId       String?
  correlationId  String
  metadata       Json?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@map("audit_events")
}

// ---------------------------------------------------------------------
// Phase 3 domain models — docs/05-MVP-ROADMAP.md "Treasury": bank
// accounts, reservations, in-transit transfers. bank_reservations and
// bank_transfers are not in docs/01-DATABASE-SPEC.md (it only defines
// bank_accounts) — added here as app-DB pointers into Formance Ledger
// transactions (never the source of truth for a balance), the same
// pattern prisma/schema.prisma.example already uses for
// Payment.ledgerTransactionId. See docs/01-DATABASE-SPEC.md's own
// updated table list for the rationale.
// ---------------------------------------------------------------------

enum BankAccountStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

model BankAccount {
  id                   String            @id @default(uuid())
  companyId            String
  providerId           String? // Phase 6+ (real providers) — no Provider table yet
  name                 String
  bankName             String
  iban                 String?
  accountNumberLast4   String?
  currency             String            @db.Char(3)
  status               BankAccountStatus @default(ACTIVE)
  ledgerAccountAddress String // lib/ledger/accounts.ts bankAddress(), computed once at creation
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  company              Company @relation(fields: [companyId], references: [id])
  reservations         BankReservation[]
  transfersOut         BankTransfer[]    @relation("SourceAccount")
  transfersIn          BankTransfer[]    @relation("DestinationAccount")
  intercompanyTransfersOut IntercompanyTransfer[] @relation("IntercompanySource")
  intercompanyTransfersIn  IntercompanyTransfer[] @relation("IntercompanyDestination")
  payments             Payment[]

  @@index([companyId])
  @@map("bank_accounts")
}

enum ReservationStatus {
  ACTIVE
  RELEASED
}

// Reserve/release move funds within one bank account's own ledger
// accounts (bank <-> reserved) — see lib/ledger/postings.ts patterns A/B.
// This row is a traceable pointer, not the balance itself (architecture
// freeze rule 4/5) — the ledgerTransactionId columns reference Formance.
model BankReservation {
  id                         String            @id @default(uuid())
  organizationId             String
  companyId                  String
  bankAccountId               String
  amount                     Decimal           @db.Decimal(20, 8)
  currency                   String            @db.Char(3)
  status                     ReservationStatus @default(ACTIVE)
  ledgerTransactionId        String // reserveFunds() result
  releaseLedgerTransactionId String? // releaseReservation() result, once released
  idempotencyKey             String
  correlationId              String
  requestedBy                String // Better Auth user id, plain column (see schema header note)
  requestedAt                DateTime          @default(now())
  releasedAt                 DateTime?

  bankAccount                BankAccount @relation(fields: [bankAccountId], references: [id])

  @@unique([bankAccountId, idempotencyKey])
  @@index([companyId, status])
  @@map("bank_reservations")
}

enum TransferStatus {
  IN_TRANSIT
  SETTLED
}

// Start/settle move funds bank -> in_transit -> destination bank account
// (lib/ledger/postings.ts patterns C/D). Phase 3 scope: destinationAccountId
// must be another BankAccount of the *same* company (validated in
// lib/treasury/transfers.ts) -- cross-company movement is Phase 4
// "Intercompany", not this phase.
model BankTransfer {
  id                         String         @id @default(uuid())
  organizationId             String
  companyId                  String
  bankAccountId              String // source
  destinationAccountId       String
  amount                     Decimal        @db.Decimal(20, 8)
  currency                   String         @db.Char(3)
  status                     TransferStatus @default(IN_TRANSIT)
  startLedgerTransactionId   String // startTransfer() result
  settleLedgerTransactionId  String? // settleTransfer() result, once settled
  idempotencyKey             String // for the start call; settle derives its own key from this row's id
  correlationId              String
  requestedBy                String
  requestedAt                DateTime       @default(now())
  settledAt                  DateTime?

  bankAccount                BankAccount @relation("SourceAccount", fields: [bankAccountId], references: [id])
  destinationAccount         BankAccount @relation("DestinationAccount", fields: [destinationAccountId], references: [id])

  @@unique([bankAccountId, idempotencyKey])
  @@index([companyId, status])
  @@map("bank_transfers")
}

// ---------------------------------------------------------------------
// Phase 4 domain model — docs/05-MVP-ROADMAP.md "Intercompany". The
// posting pattern is identical to BankTransfer's (bank -> in_transit ->
// destination, lib/ledger/postings.ts C/D) with destinationAccountId
// belonging to a *different* company -- Phase 3 restricted BankTransfer
// to same-company specifically so this model could lift that
// restriction without any lib/ledger/ changes. "Obligation" (roadmap
// wording) is this row's PENDING_APPROVAL state, not a separate table --
// docs/01-DATABASE-SPEC.md only ever specified one table here.
// ---------------------------------------------------------------------

enum IntercompanyTransferStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model IntercompanyTransfer {
  id                    String   @id @default(uuid())
  organizationId        String
  fromCompanyId         String
  toCompanyId           String
  bankAccountId         String // source, must belong to fromCompanyId
  destinationAccountId  String // must belong to toCompanyId, same currency as source
  amount                Decimal  @db.Decimal(20, 8)
  currency              String   @db.Char(3)
  purpose               String?
  status                IntercompanyTransferStatus @default(PENDING_APPROVAL)
  dueAt                 DateTime?
  startLedgerTransactionId  String? // set on approve
  settleLedgerTransactionId String? // set on approve
  idempotencyKey        String
  correlationId         String
  requestedBy            String
  requestedAt             DateTime @default(now())
  approvedBy               String?
  sentAt                    DateTime?
  receivedAt                 DateTime?
  reconciledAt                 DateTime?
  rejectedBy                    String?
  rejectedAt                     DateTime?
  rejectionReason                  String?

  fromCompany         Company     @relation("IntercompanyFrom", fields: [fromCompanyId], references: [id])
  toCompany           Company     @relation("IntercompanyTo", fields: [toCompanyId], references: [id])
  bankAccount         BankAccount @relation("IntercompanySource", fields: [bankAccountId], references: [id])
  destinationAccount  BankAccount @relation("IntercompanyDestination", fields: [destinationAccountId], references: [id])

  @@unique([bankAccountId, idempotencyKey])
  @@index([organizationId, status])
  @@map("intercompany_transfers")
}

// ---------------------------------------------------------------------
// Phase 5 domain models — docs/05-MVP-ROADMAP.md "OPEX": categories,
// expenses, recurring expenses, budgets, actual vs budget.
// expense_categories/expenses match docs/01-DATABASE-SPEC.md's column
// list exactly, with one deliberate deviation: counterpartyId/
// contractId/paymentId reference tables that don't exist yet (Phase
// 6/7) -- plain nullable columns with no FK, the same pattern as
// BankAccount.providerId above. approvedBy/approvedAt are not in the
// original spec but mirror payments.approved_by/approved_at (the same
// approval-workflow display need Phase 4 already solved for
// IntercompanyTransfer.approvedBy) -- see docs/01-DATABASE-SPEC.md's
// updated notes. recurrence is a label only in this phase: nothing
// generates future Expense rows from it yet, that's Phase 8 Forecast's
// job (docs/05-MVP-ROADMAP.md lists "recurring expenses" again there).
//
// budgets is a new table (not in the original spec), same "documented
// pointer/extension" precedent as bank_reservations/bank_transfers/
// intercompany_transfers in Phase 3/4. Monthly-calendar granularity
// (companyId, categoryId, periodYear, periodMonth) is a scope decision
// -- confirmed over a free-form date-range budget for MVP simplicity.
// ---------------------------------------------------------------------

enum ExpenseRecurrence {
  ONE_OFF
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ExpenseStatus {
  PENDING_APPROVAL
  APPROVED
}

model ExpenseCategory {
  id             String   @id @default(uuid())
  organizationId String
  code           String
  name           String
  parentId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id])
  parent         ExpenseCategory?  @relation("CategoryParent", fields: [parentId], references: [id])
  children       ExpenseCategory[] @relation("CategoryParent")
  expenses       Expense[]
  budgets        Budget[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("expense_categories")
}

model Expense {
  id             String            @id @default(uuid())
  organizationId String
  companyId      String
  categoryId     String
  counterpartyId String? // Phase 6+ real FK now that Counterparty exists (was a plain column in Phase 5)
  contractId     String? // Phase 7+ (freelancers/contracts) -- no Contract table yet
  amount         Decimal           @db.Decimal(20, 8)
  currency       String            @db.Char(3)
  recurrence     ExpenseRecurrence @default(ONE_OFF)
  dueDate        DateTime
  status         ExpenseStatus     @default(PENDING_APPROVAL)
  budgetAmount   Decimal?          @db.Decimal(20, 8)
  paymentId      String? // Phase 6+ real FK now that Payment exists (was a plain column in Phase 5)
  approvedBy     String? // not in original spec -- see header comment
  approvedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  company        Company         @relation(fields: [companyId], references: [id])
  category       ExpenseCategory @relation(fields: [categoryId], references: [id])
  counterparty   Counterparty?   @relation(fields: [counterpartyId], references: [id])
  payment        Payment?        @relation(fields: [paymentId], references: [id])

  @@index([companyId, status])
  @@index([companyId, categoryId, dueDate])
  @@map("expenses")
}

// Not in docs/01-DATABASE-SPEC.md -- see header comment above. One row
// per company/category/calendar-month; "actual" is the sum of that
// same slice's APPROVED expenses (lib/expenses/budgets.ts).
model Budget {
  id             String   @id @default(uuid())
  organizationId String
  companyId      String
  categoryId     String
  periodYear     Int
  periodMonth    Int // 1-12
  amount         Decimal  @db.Decimal(20, 8)
  currency       String   @db.Char(3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id])
  category       ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@unique([companyId, categoryId, periodYear, periodMonth])
  @@index([organizationId])
  @@map("budgets")
}

// ---------------------------------------------------------------------
// Phase 6 domain models — docs/05-MVP-ROADMAP.md "Payment orchestration":
// approval workflow, provider interface, mock provider, webhook
// framework, failure/retry model. Tables match docs/01-DATABASE-SPEC.md
// (counterparties, beneficiaries, providers, payments, webhooks) with
// documented trims/additions below.
//
// PaymentStatus is trimmed from prisma/schema.prisma.example's 10 states
// to the 7 this phase's endpoints actually drive (no DRAFT -- POST
// /payments per docs/03-API-SPEC.md creates directly at PENDING_APPROVAL,
// same as IntercompanyTransfer/Expense; no SENT/REVERSED -- not reachable
// by any endpoint yet). retryCount is not in the original spec: it backs
// the roadmap's "failure/retry model" -- POST /payments/:id/execute may
// be called again on a FAILED payment (lib/payments/payments.ts caps
// retries), each attempt getting its own ledger idempotency key.
//
// providers.organization_id is NOT NULL per docs/01-DATABASE-SPEC.md, so
// each org gets its own row per provider type, auto-provisioned on first
// use (lib/providers/registry.ts getOrCreateProvider) rather than a
// manual "configure a provider" admin flow -- there's nothing to
// configure for a mock provider, and CLAUDE.md rule 13 rules out real
// provider setup work not asked for by an explicit task.
//
// beneficiaries.payout_details_encrypted is encrypted at the application
// layer (lib/crypto/encryption.ts, AES-256-GCM, key from
// PAYOUT_ENCRYPTION_KEY) before it ever reaches this column -- the
// column name in docs/01-DATABASE-SPEC.md says so explicitly.
//
// reconciliations (docs/01-DATABASE-SPEC.md) and SignatureProvider
// (docs/06-PROVIDER-INTERFACES.md) are deliberately out of scope here --
// neither is in this phase's roadmap bullets; reconciliation exceptions
// arrive with Phase 9's real provider, e-signature with Phase 7.
// ---------------------------------------------------------------------

enum CounterpartyType {
  COMPANY
  INDIVIDUAL
}

enum CounterpartyStatus {
  ACTIVE
  INACTIVE
}

// Shared by Beneficiary.paymentMethod and Payment.paymentMethod --
// MANUAL means no provider call at all (an offline/manual payment the
// application just records; see lib/payments/payments.ts executePayment).
enum PaymentMethod {
  BANK_TRANSFER
  CRYPTO_EXCHANGE
  CARD_PAYOUT
  MANUAL
}

enum BeneficiaryStatus {
  ACTIVE
  INACTIVE
}

// MOCK_* only for this phase (docs/06-PROVIDER-INTERFACES.md) -- a real
// value needs its own provider-specific task (CLAUDE.md rule 13).
enum ProviderType {
  MOCK_BANK
  MOCK_CRYPTO
  MOCK_PAYOUT
}

enum ProviderStatus {
  ACTIVE
  INACTIVE
}

enum PaymentType {
  INTERCOMPANY
  FREELANCER
  SUPPLIER
  TAX
  OPERATING_EXPENSE
  CRYPTO
  OTHER
}

enum PaymentStatus {
  PENDING_APPROVAL
  APPROVED
  PROCESSING
  SETTLED
  FAILED
  REJECTED
  CANCELLED
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  IGNORED
  ERROR
}

model Counterparty {
  id                 String              @id @default(uuid())
  organizationId     String
  legalName          String
  type               CounterpartyType
  countryCode        String?             @db.Char(2)
  registrationNumber String?
  taxIdentifier      String?
  externalReference  String?
  status             CounterpartyStatus  @default(ACTIVE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  organization       Organization @relation(fields: [organizationId], references: [id])
  beneficiaries      Beneficiary[]
  payments           Payment[]
  expenses           Expense[]

  @@index([organizationId])
  @@map("counterparties")
}

// payoutDetailsEncrypted holds an opaque ciphertext blob (base64) from
// lib/crypto/encryption.ts -- never a plaintext IBAN/wallet address.
model Beneficiary {
  id                       String            @id @default(uuid())
  counterpartyId           String
  paymentMethod            PaymentMethod
  payoutDetailsEncrypted   String
  status                   BeneficiaryStatus @default(ACTIVE)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  counterparty             Counterparty @relation(fields: [counterpartyId], references: [id])
  payments                 Payment[]

  @@index([counterpartyId])
  @@map("beneficiaries")
}

model Provider {
  id                     String         @id @default(uuid())
  organizationId         String
  type                   ProviderType
  name                   String
  status                 ProviderStatus @default(ACTIVE)
  configurationReference String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  organization           Organization @relation(fields: [organizationId], references: [id])
  payments               Payment[]
  webhooks               Webhook[]

  @@unique([organizationId, type])
  @@map("providers")
}

model Payment {
  id                  String        @id @default(uuid())
  organizationId      String
  companyId           String
  beneficiaryId       String
  counterpartyId      String? // denormalized from beneficiary for query convenience, set at creation
  providerId          String?
  bankAccountId       String // not in original spec -- docs/01-DATABASE-SPEC.md's payments table has no funding-source column, but executePayment (lib/payments/payments.ts) must know which BankAccount to debit for the ledger BANK -> IN_TRANSIT posting (docs/02-LEDGER-SPEC.md pattern C); mirrors BankTransfer.bankAccountId
  contractId          String? // Phase 7+ -- no Contract table yet
  amount              Decimal       @db.Decimal(20, 8)
  currency            String        @db.Char(3)
  paymentType         PaymentType
  paymentMethod       PaymentMethod
  status              PaymentStatus @default(PENDING_APPROVAL)
  idempotencyKey      String
  providerPaymentId   String?
  ledgerTransactionId String? // startTransfer() result, set on execute
  settleLedgerTransactionId String? // settleTransfer()/reverseTransfer() result, set on webhook outcome -- not in original spec, same pointer-field precedent as BankTransfer.settleLedgerTransactionId
  retryCount          Int           @default(0) // not in original spec -- see header comment
  requestedBy         String
  approvedBy          String?
  requestedAt         DateTime      @default(now())
  approvedAt          DateTime?
  executedAt          DateTime?
  settledAt           DateTime?
  failureCode         String?
  failureReason       String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  company             Company      @relation(fields: [companyId], references: [id])
  bankAccount         BankAccount  @relation(fields: [bankAccountId], references: [id])
  beneficiary         Beneficiary  @relation(fields: [beneficiaryId], references: [id])
  provider            Provider?    @relation(fields: [providerId], references: [id])
  counterparty        Counterparty? @relation(fields: [counterpartyId], references: [id])
  expenses            Expense[]

  @@unique([companyId, idempotencyKey])
  @@index([organizationId, status])
  @@index([companyId, createdAt])
  @@map("payments")
}

// Append-only per row (no update/delete grant, see AuditEvent) except the
// status/processedAt/errorMessage transition RECEIVED -> PROCESSED/ERROR
// that lib/providers/webhook.ts makes as it handles the event -- unlike
// AuditEvent this is operational state, not a financial history record.
model Webhook {
  id               String        @id @default(uuid())
  providerId       String
  externalEventId  String
  eventType        String
  signatureValid   Boolean
  payloadHash      String
  receivedAt       DateTime      @default(now())
  processedAt      DateTime?
  status           WebhookStatus @default(RECEIVED)
  errorMessage     String?

  provider         Provider @relation(fields: [providerId], references: [id])

  @@unique([providerId, externalEventId])
  @@map("webhooks")
}
