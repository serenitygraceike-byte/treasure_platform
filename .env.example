NODE_ENV=development

# Application
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://treasury:treasury_dev_only@localhost:5432/treasury

# Better Auth
BETTER_AUTH_SECRET=REPLACE_WITH_32+_CHAR_HIGH_ENTROPY_SECRET
BETTER_AUTH_URL=http://localhost:3000

# Formance (infrastructure/docker/docker-compose.dev.yml publishes 3068
# locally; in production this must be the internal docker hostname —
# http://formance-ledger:3068 — see infrastructure/production/README.md)
FORMANCE_BASE_URL=http://localhost:3068
FORMANCE_STACK=treasury-dev
FORMANCE_API_TOKEN=

# infrastructure/production/docker-compose.yml only — bootstraps the app
# Postgres container and must match the credentials embedded in
# DATABASE_URL above once deployed there. Not used by local `pnpm dev`.
POSTGRES_USER=treasury
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=treasury

# infrastructure/production/docker-compose.yml only — bootstraps
# formance-postgres, the Ledger's own database (separate from the app DB).
FORMANCE_POSTGRES_USER=ledger
FORMANCE_POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
FORMANCE_POSTGRES_DB=ledger

# Provider secrets - placeholders only (no real provider implemented yet,
# docs/06-PROVIDER-INTERFACES.md/CLAUDE.md rule 13 -- unused by the mock
# providers Phase 6 actually wires up)
BANK_PROVIDER_API_KEY=
CRYPTO_PROVIDER_API_KEY=
PAYOUT_PROVIDER_API_KEY=
SIGNATURE_PROVIDER_API_KEY=

# Phase 6 -- AES-256-GCM key for beneficiaries.payout_details_encrypted
# (lib/crypto/encryption.ts). Must be a real random 32-byte value,
# base64-encoded, in production: `openssl rand -base64 32`.
PAYOUT_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# Phase 6 -- HMAC secret the mock providers use to sign webhook payloads
# (lib/providers/mock-*.ts) and lib/providers/webhook.ts uses to verify
# them. Mock-only; a real provider's own webhook secret is unrelated.
MOCK_PROVIDER_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET

# Phase 9A -- Piraeus Bank rAPId Link (PB API Accounts), read-only AIS
# integration. docs/13-PIRAEUS-PROVIDER.md. Never commit real values --
# install them on the server through the existing production secret
# mechanism (docs/11-DEPLOYMENT-WORKFLOW.md), not Git.
PIRAEUS_CLIENT_ID=
PIRAEUS_CLIENT_SECRET=
# Confirmed via https://rapidlink.piraeusbank.gr (search-indexed content
# only -- the portal's own pages could not be fetched directly, see
# docs/13-PIRAEUS-PROVIDER.md "Assumptions"). Base gateway pattern:
# https://api.rapidlink.piraeusbank.gr/piraeusbank/{environment}
PIRAEUS_ENVIRONMENT=sandbox
PIRAEUS_BASE_URL=https://api.rapidlink.piraeusbank.gr/piraeusbank/sandbox
PIRAEUS_AUTHORIZE_URL=https://rapidlink.piraeusbank.gr/oauth2/authorize
PIRAEUS_TOKEN_URL=https://api.rapidlink.piraeusbank.gr/piraeusbank/sandbox/oauth2/token
# winbankAccess.info is the read-only-looking scope found via search;
# unconfirmed against the actual portal -- see docs/13-PIRAEUS-PROVIDER.md.
PIRAEUS_SCOPE=winbankAccess.info
PIRAEUS_REDIRECT_URI=http://localhost:3000/api/v1/providers/piraeus/callback

# Phase 9A -- AES-256-GCM key for provider_connections' encrypted OAuth
# tokens (lib/crypto/encryption.ts). Separate from PAYOUT_ENCRYPTION_KEY.
# `openssl rand -base64 32`.
PIRAEUS_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# Phase 9A -- keyed-HMAC secret for deterministic account matching
# without comparing/logging raw IBANs (lib/crypto/encryption.ts
# fingerprintAccountIdentifier). `openssl rand -base64 32`.
PIRAEUS_FINGERPRINT_KEY=REPLACE_WITH_RANDOM_SECRET

# Phase 9A sync worker (scripts/piraeus-sync-worker.ts) -- conservative
# defaults, not a confirmed Piraeus rate limit (none published/found).
# Adjustable without a redeploy of secrets.
PIRAEUS_SYNC_POLL_INTERVAL_SECONDS=900
PIRAEUS_SYNC_LOOKBACK_DAYS=7
PIRAEUS_MANUAL_SYNC_COOLDOWN_SECONDS=300

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
